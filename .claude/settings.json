{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(*)",
      "PowerShell(*)",
      "Read(**)",
      "Edit(**)",
      "Write(**)",
      "Glob(**)",
      "Grep(**)",
      "WebFetch(domain:developer.pancake.biz)",
      "WebFetch(domain:open.larksuite.com)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf ../*)",
      "Bash(sudo rm*)",
      "PowerShell(Remove-Item -Recurse *\\..\\*)",
      "PowerShell(Remove-Item -Recurse C:\\*)",
      "Bash(git push --force*)"
    ]
  }
}